---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getRepositories, projectArea, repositoryCategory, snapshotLabel, GITHUB } from '../lib/portfolio';
const projects = await getProjects();
const repositories = await getRepositories();
const years = [...new Set(repositories.map(repo => repo.created_at.slice(0,4)))];
---
<BaseLayout title="Work" description="Project stories and a complete public repository archive." route="/work.html" active="Work">
  <div class="wrap">
    <PageIntro kicker="THE WORK / 2023–2026" description="Products, engineering stories, visual experiments, and the earlier work that led here.">An evolving<br /><em>body of work.</em></PageIntro>
    <nav class="work-count" aria-label="Work collections"><a href="#project-stories">Project stories <span>{projects.length}</span></a><a href="#repository-archive">Repository archive <span>{repositories.length}</span> <span aria-hidden="true">↓</span></a></nav>
    <section id="project-stories" aria-label="Project stories">
      <h2 class="visually-hidden">Project stories</h2>
      <div class="story-filters" data-story-controls hidden>
        <div role="group" aria-label="Filter project stories">
          {['All work', 'AI & systems', 'Products', 'Experiments'].map(area => <button type="button" data-story-area={area} aria-pressed={area === 'All work' ? 'true' : 'false'}>{area}<span>{area === 'All work' ? projects.length : projects.filter(project => projectArea(project.id) === area).length}</span></button>)}
        </div>
        <p id="story-status" role="status" aria-live="polite">Showing all {projects.length} stories</p>
      </div>
      <div class="all-studies">{projects.map(project => <ProjectCard project={project} />)}</div>
    </section>
    <section class="repository-archive" id="repository-archive">
      <div class="section-heading">
        <div><span class="section-index">THE COMPLETE REPOSITORY ARCHIVE</span><h2>Keep the<br /><em>earlier chapters.</em></h2></div>
        <p>Organized by repository creation year.<br />Public, non-fork repositories · {snapshotLabel}.</p>
      </div>
      <form class="archive-controls" data-repo-controls role="search" hidden>
        <label>Find a repository<input id="repo-search" type="search" placeholder="Search by name or language" autocomplete="off" /></label>
        <label>Area<select id="repo-category"><option value="all">All areas</option>{['AI','Product','Data','Foundations'].map(area => <option>{area}</option>)}</select></label>
        <label>Year<select id="repo-year"><option value="all">Every year</option>{years.map(year => <option>{year}</option>)}</select></label>
        <button type="reset">Reset</button>
      </form>
      <p class="filter-status" id="repo-status" role="status" aria-live="polite">{repositories.length} repositories</p>
      <div class="repo-table">
        {repositories.map(repo => (
          <a class="repo-row" data-repo data-category={repositoryCategory(repo.name)} data-year={repo.created_at.slice(0,4)} href={`${GITHUB}jadhavgaurav/${repo.name}`} target="_blank" rel="noopener noreferrer">
            <span class="repo-year">{repo.created_at.slice(0,4)}</span>
            <span class="repo-name">{repo.name}{repo.description && <small>{repo.description}</small>}</span>
            <span class="repo-language">{repo.language || 'Repository'}</span>
            <span class="repo-category">{repositoryCategory(repo.name)}</span><span aria-hidden="true">+</span>
          </a>
        ))}
      </div>
      <p class="empty-results" id="repo-empty" hidden>No repositories match. Try another name or clear the filters.</p>
    </section>
  </div>
</BaseLayout>
<script>import '../scripts/repositories.js';</script>
