---
const stories = [
  {
    name: 'OyeChats', area: 'AI ENGINEERING', href: '/projects/oyechats.html',
    headline: 'Better answers start before the answer.',
    description: 'Retrieval diagnosis, a consolidated RAG pipeline, and durable qualification jobs.',
    result: '15,233 → 8,120', note: 'tokens in one assembled prompt, documented in the remediation PR',
    evidence: [['Retrieval diagnosis', 'https://github.com/digibranders/oye-chats-platform/pull/450'], ['Prompt & durability', 'https://github.com/digibranders/oye-chats-platform/pull/455']],
  },
  {
    name: 'CleanStart', area: 'PRODUCT ENGINEERING', href: '/projects/cleanstart.html',
    headline: 'Fewer requests. Correct timing.',
    description: 'Batched CMS lookups and cache invalidation that waits for the transaction to commit.',
    result: '~75 → 2', note: 'relationship requests in the documented 25-row list view',
    evidence: [['CMS performance', 'https://github.com/digibranders/cleanstart-web/pull/279'], ['Cache correctness', 'https://github.com/digibranders/cleanstart-web/pull/276']],
  },
  {
    name: 'AlsoNotify', area: 'PRODUCT SYSTEMS', href: '/projects/alsonotify.html',
    headline: 'Trust is a product feature.',
    description: 'Authentication, safer email rendering, and reporting rules shared by the interface and exported PDF.',
    result: 'One KPI definition', note: 'consistent reporting across the interface and PDF', evidence: [],
  },
];
---
<section class="practice-section" id="practice" aria-labelledby="practice-title">
  <div class="wrap">
    <div class="section-heading">
      <div><span class="section-index">02 / ENGINEERING IN PRACTICE</span><h2 id="practice-title">Small decisions.<br /><em>Real impact.</em></h2></div>
      <p>The work that makes a product<br />faster, safer, and more dependable.</p>
    </div>
    <div class="practice-list">
      {stories.map(story => (
        <article class="practice-item">
          <div class="practice-label"><span class="eyebrow">{story.area}</span><h3>{story.name}</h3><p class="practice-lede">{story.headline}</p></div>
          <div class="practice-body">
            <p>{story.description}</p>
            <div class="result"><strong>{story.result}</strong><span>{story.note}</span></div>
            <a class="study-link" href={story.href}>Read the story <span aria-hidden="true">↗</span></a>
            {story.evidence.length > 0 && <details class="practice-evidence"><summary>Public evidence <span aria-hidden="true">+</span></summary><div class="inline-links">{story.evidence.map(([label, url]) => <a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a>)}</div></details>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
