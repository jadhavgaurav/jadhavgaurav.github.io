---
interface Props { active?: 'Work' | 'Open source' | 'Journey'; home?: boolean; }
const { active, home = false } = Astro.props;
const links = [
  { label: 'Work', href: '/work.html' },
  { label: 'Open source', href: '/open-source.html' },
  { label: 'Journey', href: '/journey.html' },
];
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="header-shell">
<header class="site-header wrap">
  <a class="brand" href={home ? '#top' : '/'} aria-label="Gaurav Jadhav, home"><span class="wordmark">gj<span>.</span></span><span class="header-name">Gaurav Jadhav<span>AI & product engineer</span></span></a>
  <nav aria-label="Main navigation">
    {links.map(link => <a href={link.href} aria-current={active === link.label ? 'page' : undefined}>{link.label}</a>)}
    <a class="nav-contact" href={home ? '#contact' : '/#contact'}>Let's talk<span class="link-dot" aria-hidden="true"></span></a>
  </nav>
</header>
</div>
